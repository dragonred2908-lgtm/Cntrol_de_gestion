# NÚCLEO CONTROL / Control de Gestión — variables de entorno
# Copia este archivo y ajusta los valores:
#   cp .env.example .env
# .env NO se versiona. No subas secretos al repositorio.

# Entorno de ejecución: development | production
NODE_ENV="development"

# Puerto HTTP del proceso único que sirve la SPA y la API
PORT="3000"

# URL pública de la aplicación, SIN barra final
# Ejemplo en producción: https://control.midominio.com
APP_URL="http://localhost:3000"

# Clave para firmar los tokens de sesión (HMAC-SHA256, TTL 12 h).
# Genérala con: openssl rand -hex 32
# Déjala vacía solo en local: si falta, se deriva del PIN y el servidor avisa por consola.
# En producción es OBLIGATORIA.
AUTH_SECRET=""

# Orígenes permitidos para CORS, separados por comas
# Ejemplo: https://control.midominio.com,https://www.midominio.com
CORS_ORIGINS=""

# PIN de acceso a la web. ADVERTENCIA: cámbialo antes de exponer el servicio,
# el valor 123456 es solo para pruebas locales. Un PIN compartido = acceso compartido.
ADMIN_PIN="123456"

# API key de Google Gemini para el análisis de KPIs (modelo gemini-3.8-flash).
# Vacío = análisis por IA desactivado. Envía a Google agregados y nombres de integrantes:
# revisa docs/PRIVACIDAD.md antes de activarlo.
GEMINI_API_KEY=""

# Token del bot de Telegram (de @BotFather). Vacío = integración desactivada.
TELEGRAM_BOT_TOKEN=""

# ID del grupo de destino. Los grupos empiezan por -100 (ejemplo: -1001234567890).
TELEGRAM_GROUP_CHAT_ID=""

# Quién puede ejecutar comandos de administración en el bot (ej. /actualizar).
# Separados por comas; admite ID numérico o @usuario. Ejemplo: 123456789,@fulano
TELEGRAM_ADMIN_IDS=""
